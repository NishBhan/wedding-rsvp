# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key - server-only, never exposed to the browser.
# Used only by the admin page to read all RSVPs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple shared password for the /admin page. Not real auth,
# just enough to keep randoms out. Change it before you deploy.
ADMIN_PASSWORD=choose-a-password
